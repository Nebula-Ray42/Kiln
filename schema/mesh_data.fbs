namespace kiln.format.fbs;

struct Vec2 {
    x: float;
    y: float;
}

struct Vec3 {
    x: float;
    y: float;
    z: float;
}

table Mesh {
    positions: [Vec3] (required);  // 位置は必須
    normals: [Vec3];               // オプション
    uvs: [Vec2];                   // オプション

    // インデックスバッファ
    indices_u16: [uint16];
    indices_u32: [uint32];

    // 今後の拡張（アニメ調PBRやマテリアル対応）の予約枠
    // material_id: uint32;
    // vertex_colors: [Vec3];
}

root_type Mesh;