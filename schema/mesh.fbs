namespace kiln.schema;

// リスト1: 位置情報 (x, y, z)
struct Position {
  x: float;
  y: float;
  z: float;
}

// リスト2: 色塗りに必要なその他の情報 (UV, 法線など)
struct VertexAttribute {
  u: float;
  v: float;
  nx: float;
  ny: float;
  nz: float;
  // TODO 後でトゥーンシェーディング用に頂点カラーなどを追加
}

table MeshData {
  // 位置だけの配列
  positions: [Position];

  // 色塗り用の情報の配列
  attributes: [VertexAttribute];

  // インデックスデータ
  indices: [uint];
}

root_type MeshData;